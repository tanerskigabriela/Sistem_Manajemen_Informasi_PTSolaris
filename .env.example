PORT=3000
NODE_ENV=development

# SQL Server (tahap RSI memakai login app_rsi)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=solaris_db
DB_USER=app_rsi
DB_PASSWORD=ganti-dengan-password

# Disiapkan untuk tahap SMBD (opsional di tahap RSI)
# DB_SMBD_USER=app_smbd
# DB_SMBD_PASSWORD=ganti-dengan-password

# CORS & Autentikasi JWT
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_TTL_SECONDS=28800
SESSION_TIMEOUT_MINUTES=30